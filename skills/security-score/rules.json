  "rule_version": 2,
  "change_relevance": {
    "version": 1,
    "documentation_extensions": [
      ".md",
      ".rst",
      ".adoc",
      ".txt"
    ],
    "path_rules": [
      {
        "id": "REL-AGENT-INSTRUCTIONS",
        "level": "high",
        "aspect": "agent authority",
        "pattern": "(?i)(^|/)(AGENTS|SKILL|CLAUDE|GEMINI)\\.md$|(^|/)(agents|prompts)/",
        "reason": "Agent instructions or prompts changed; review action authority and trusted context."
      },
      {
        "id": "REL-DEPENDENCIES",
        "level": "high",
        "aspect": "dependency resolution",
        "pattern": "(?i)(^|/)(package(?:-lock)?\\.json|npm-shrinkwrap\\.json|pnpm-lock\\.yaml|yarn\\.lock|requirements[^/]*\\.txt|pyproject\\.toml|poetry\\.lock|uv\\.lock|Gemfile(?:\\.lock)?|Cargo\\.(?:toml|lock)|go\\.(?:mod|sum)|composer\\.(?:json|lock)|pom\\.xml|build\\.gradle(?:\\.kts)?|\\.npmrc)$",
        "reason": "Dependency declarations, resolution or package sources changed; review supply-chain consequences."
      },
      {
        "id": "REL-PIPELINE",
        "level": "high",
        "aspect": "build and deployment authority",
        "pattern": "(?i)(^|/)(Dockerfile[^/]*|Jenkinsfile|CODEOWNERS|\\.gitlab-ci\\.ya?ml|azure-pipelines\\.ya?ml|docker-compose[^/]*\\.ya?ml)$|(^|/)(\\.github/workflows|\\.circleci)/|(^|/)(deploy|charts|helm|k8s)/.*\\.(?:ya?ml|json|tf)$",
        "reason": "Build, release, ownership or deployment configuration changed; review execution and privileges."
      },
      {
        "id": "REL-CREDENTIAL-CONFIG",
        "level": "high",
        "aspect": "credentials and configuration",
        "pattern": "(?i)(^|/)(\\.env(?:\\.[^/]*)?|credentials(?:\\.[^/]*)?|secrets?\\.(?:json|ya?ml)|id_rsa|id_ed25519|[^/]+\\.(?:pem|key|p12|pfx))$",
        "reason": "Credential or secret configuration changed; excluded contents are not read or disclosed."
      },
      {
        "id": "REL-SECURITY-GUIDANCE",
        "level": "medium",
        "aspect": "documented security assumptions",
        "pattern": "(?i)(^|/)(SECURITY\\.md|threat-model[^/]*\\.md|security-policy[^/]*\\.md)$",
        "reason": "Security policy or threat-model assumptions changed; review their applicability."
      }
    ],
    "code_rules": [
      {
        "id": "REL-AUTH",
        "level": "high",
        "aspect": "identity and authorization",
        "pattern": "(?i)@\\w*(?:auth|login|permission|role)\\w*|\\b(?:authorize|authenticate|requireAuth|requireRole|check_permission|hasRole|isAuthenticated|jwt\\.(?:verify|decode)|passport\\.\\w+)\\s*\\(|\\b(?:role|permissions|tenantId|tenant_id|ownerId|owner_id)\\b[\\\"\\x27]?\\s*[:=]",
        "reason": "Identity, permissions or ownership behavior changed, regardless of whether a weakness was detected."
      },
      {
        "id": "REL-ENTRYPOINT",
        "level": "high",
        "aspect": "entry points and trust boundaries",
        "pattern": "(?i)@\\w*(?:route|mapping)\\s*\\(|\\b(?:app|router|server)\\s*\\.\\s*(?:get|post|put|patch|delete|route|use|mapget|mappost)\\s*\\(|\\bhttp\\.Handle(?:Func)?\\s*\\(",
        "reason": "An entry point, route or middleware registration changed; review callers and enforced boundaries."
      },
      {
        "id": "REL-NETWORK",
        "level": "high",
        "aspect": "external data flows",
        "pattern": "(?i)\\b(?:requests\\.(?:get|post|put|patch|delete|request)|fetch|axios\\.(?:get|post|request)|https?\\.request)\\s*\\(",
        "reason": "An external request or data-flow operation changed; review destinations, data and credentials."
      },
      {
        "id": "REL-DATA-ACCESS",
        "level": "high",
        "aspect": "persistence and data access",
        "pattern": "(?i)\\.(?:execute|executemany|query|findOne|findById|findUnique|queryRaw|queryRawUnsafe)\\s*\\(|\\b(?:from|import)\\s+(?:sqlalchemy|psycopg\\w*|sqlite3|pymongo)\\b",
        "reason": "A persistence or query operation changed; review parameter binding, ownership and database privileges."
      },
      {
        "id": "REL-PROTECTION",
        "level": "high",
        "aspect": "security controls",
        "pattern": "(?i)Content-Security-Policy|\\brejectUnauthorized\\b|\\b(?:httpOnly|sameSite|csrf|cors|CSP_\\w+|SESSION_COOKIE_\\w+)\\b\\s*[:=(]",
        "reason": "A browser, request or transport protection changed; no defect is implied by relevance alone."
      },
      {
        "id": "REL-CRYPTO",
        "level": "high",
        "aspect": "secrets and cryptography",
        "pattern": "(?i)\\b(?:hashlib|crypto|bcrypt|argon2|scrypt|secrets)\\s*\\.|\\b(?:password|secret|token|api_key|private_key)\\w*\\s*[:=]",
        "reason": "Secret handling or a cryptographic operation changed; review its purpose and lifecycle."
      },
      {
        "id": "REL-FRONTEND",
        "level": "medium",
        "aspect": "frontend output and input handling",
        "pattern": "(?i)\\b(?:dangerouslySetInnerHTML|innerHTML|textContent|bypassSecurityTrustHtml)\\b|\\b(?:validate|sanitize|escapeHtml|parse|serialize)\\s*\\(",
        "reason": "Frontend output, validation or serialization changed; inspect the affected input and rendering context."
      }
    ],
    "area_rules": {
      "execution": {
        "id": "REL-CONTROL-EXECUTION",
        "level": "high",
        "aspect": "execution",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "injection": {
        "id": "REL-CONTROL-INJECTION",
        "level": "high",
        "aspect": "injection",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "transport": {
        "id": "REL-CONTROL-TRANSPORT",
        "level": "high",
        "aspect": "transport",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "cryptography": {
        "id": "REL-CONTROL-CRYPTOGRAPHY",
        "level": "high",
        "aspect": "cryptography",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "deserialization": {
        "id": "REL-CONTROL-DESERIALIZATION",
        "level": "high",
        "aspect": "deserialization",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "hardening": {
        "id": "REL-CONTROL-HARDENING",
        "level": "high",
        "aspect": "hardening",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "frontend-policy": {
        "id": "REL-CONTROL-FRONTEND-POLICY",
        "level": "high",
        "aspect": "frontend-policy",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "supply-chain": {
        "id": "REL-CONTROL-SUPPLY-CHAIN",
        "level": "high",
        "aspect": "supply-chain",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      },
      "output": {
        "id": "REL-CONTROL-OUTPUT",
        "level": "medium",
        "aspect": "output",
        "reason": "A recognized security operation or control is in or near changed lines; review its changed context even when no finding is emitted."
      }
    },
    "documentation_rule": {
      "id": "REL-DOCUMENTED-SECURITY",
      "level": "medium",
      "aspect": "documented security behavior",
      "pattern": "(?i)\\b(auth(?:entication|orization)?|password|secret|token|credential|security|CSP|CSRF|CORS|permission|privacy|encryption|dependenc(?:y|ies)|install|sudo|curl|wget)\\b",
      "reason": "Changed documentation contains security or installation guidance; review the described assumptions."
    },
    "executable_rule": {
      "id": "REL-EXECUTABLE-MODE",
      "level": "high",
      "aspect": "execution permissions",
      "reason": "Executable permission changed; review how this file can be invoked."
    },
    "examples": [
      {
        "file": "auth.py",
        "before": "def authorize(user):\n    return True\n",
        "after": "def authorize(user):\n    return user.is_admin\n",
        "expected_relevance": "high"
      },
      {
        "file": "routes.py",
        "before": "def list_items():\n    return []\n",
        "after": "@login_required\ndef list_items():\n    return []\n",
        "expected_relevance": "high"
      },
      {
        "file": "db.py",
        "before": "cursor.execute(f\"SELECT name FROM items WHERE id={identifier}\")\n",
        "after": "cursor.execute(\"SELECT name FROM items WHERE id=?\", (identifier,))\n",
        "expected_relevance": "high"
      },
      {
        "file": "package.json",
        "before": "{\"dependencies\":{\"example\":\"1.0.0\"}}",
        "after": "{\"dependencies\":{\"example\":\"2.0.0\"}}",
        "expected_relevance": "high"
      },
      {
        "file": "View.jsx",
        "before": "element.textContent = first;\n",
        "after": "element.textContent = second;\n",
        "expected_relevance": "medium"
      },
      {
        "file": "README.md",
        "before": "# Project\nAn example.\n",
        "after": "# Project\nAn updated example.\n",
        "expected_relevance": "low"
      },
      {
        "file": "README.md",
        "before": "# Project\n",
        "after": "# Project\nAuthentication is required.\n",
        "expected_relevance": "medium"
      },
      {
        "file": "app.py",
        "before": "def compute(value):\n    return value + 1\n",
        "after": "def compute(value):\n    return value + 2\n",
        "expected_relevance": "unclear"
      },
      {
        "file": "auth.py",
        "before": "authorize(user)\n",
        "after": "# Comment added\nauthorize(user)\n",
        "expected_relevance": "low"
      },
      {
        "file": "AGENTS.md",
        "before": "Read the project.\n",
        "after": "Read and publish the project.\n",
        "expected_relevance": "high"
      },
      {
        "file": "tool.py",
        "before": "print(1)\n",
        "after": "print(1)\n",
        "before_executable": false,
        "after_executable": true,
        "expected_relevance": "high"
      }
    ]
  }
}
