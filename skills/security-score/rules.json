    {
      "id": "NPM-LOCK",
      "kind": "npm-lock",
      "area": "supply-chain",
      "severity": "medium",
      "title": "Dependency lock evidence is unavailable or inconsistent",
      "criteria": "A selected npm v2/v3 lock whose root dependency declarations match package.json is a positive consistency signal. Missing, stale, other-manager or out-of-scope locks remain unclear. This does not establish package integrity or vulnerability status.",
      "next_action": "Maintain a reviewed lockfile and use frozen install mode.",
      "examples": [
        {
          "file": "package.json",
          "source": "{\"dependencies\":{\"example\":\"1.0.0\"}}",
          "outcome": "unclear",
