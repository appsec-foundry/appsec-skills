          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "requirements.txt",
          "source": "example-package==1.0.0\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "CI-PERMISSIONS",
      "kind": "workflow-permissions",
      "area": "supply-chain",
      "severity": "high",
      "title": "Workflow requests write-all permissions",
      "criteria": "Recognize explicit write-all and read-all GitHub workflow permissions. Scoped or inherited permissions need context; absence is not proof of missing protection.",
      "next_action": "Grant only the permissions required by each job.",
      "examples": [
        {
          "file": ".github/workflows/check.yml",
          "source": "permissions: write-all\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": ".github/workflows/check.yml",
          "source": "permissions: read-all\n",
          "outcome": "satisfied",
