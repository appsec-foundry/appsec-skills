{
  "schema_version": 1,
  "scoring_version": 2,
  "scoring": {
    "weights": {
      "critical": 50,
      "high": 25,
      "medium": 10,
      "low": 3
    },
    "severity_caps": {
      "critical": 39,
      "high": 59,
      "medium": 79,
      "low": 89
    },
    "grade_bands": [
      [
        90,
        "A"
      ],
      [
        80,
        "B"
      ],
      [
        70,
        "C"
      ],
      [
        60,
        "D"
      ],
      [
        50,
        "E"
      ],
      [
        0,
        "F"
      ]
    ],
    "aggregation": "weakest assessed area",
    "repetitions": "weight * instances"
  },
  "description": "Compact independent static checks for selected Python, JavaScript/TypeScript, GitHub Actions and Dockerfile mechanisms. No Analyzer parity or runtime verification claim.",
  "rules": [
    {
      "id": "PY-EXEC",
      "kind": "py-exec",
      "area": "execution",
      "severity": "high",
      "title": "Dynamic Python code execution",
      "criteria": "Recognize eval/exec calls; ast.literal_eval is the narrow data-only alternative.",
      "next_action": "Keep input as data; use a fixed operation or a data-only parser.",
      "examples": [
        {
          "file": "app.py",
          "source": "eval(payload)\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "ast.literal_eval(payload)\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "PY-SHELL",
      "kind": "py-shell",
      "area": "execution",
      "severity": "high",
      "title": "Python subprocess uses a shell",
      "criteria": "Recognize literal shell=True; a literal argument list without a shell satisfies this specific check.",
      "next_action": "Use a fixed executable and an argument list with shell=False; validate operation-specific arguments.",
      "examples": [
        {
          "file": "app.py",
          "source": "subprocess.run(command, shell=True)\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "subprocess.run(['tool', argument], shell=False)\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "app.py",
          "source": "subprocess.run(command, shell=setting)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-SQL",
      "kind": "py-sql",
      "area": "injection",
      "severity": "high",
      "title": "SQL execution receives a constructed expression",
      "criteria": "Recognize f-strings and binary expressions passed to execute/executemany; literal SQL satisfies only this construction check.",
      "next_action": "Use a constant query with database-bound parameters.",
      "examples": [
        {
          "file": "app.py",
          "source": "cursor.execute(f'SELECT * FROM items WHERE id={item_id}')\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "cursor.execute('SELECT * FROM items WHERE id=?', (item_id,))\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "app.py",
          "source": "cursor.execute(query)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-TLS",
      "kind": "py-tls",
      "area": "transport",
      "severity": "high",
      "title": "Requests certificate verification disabled",
      "criteria": "Recognize requests module calls with verify=False; true or its documented default satisfies this check.",
      "next_action": "Keep certificate verification enabled and configure the appropriate trust store.",
      "examples": [
        {
          "file": "app.py",
          "source": "requests.get(url, verify=False)\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "requests.get(url, verify=True)\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "app.py",
          "source": "requests.get(url, verify=setting)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-YAML",
      "kind": "py-yaml",
      "area": "deserialization",
      "severity": "high",
      "title": "YAML executable object loader selected",
      "criteria": "Recognize yaml.Loader/UnsafeLoader and their C variants; recognize safe_load and SafeLoader.",
      "next_action": "Use yaml.safe_load or an explicitly safe data-only loader.",
      "examples": [
        {
          "file": "app.py",
          "source": "yaml.load(payload, Loader=yaml.Loader)\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "yaml.safe_load(payload)\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "app.py",
          "source": "yaml.load(payload, Loader=loader)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-PICKLE",
      "kind": "py-pickle",
      "area": "deserialization",
      "severity": "high",
      "title": "Pickle deserialization requires a trusted source",
      "criteria": "Recognize pickle.load/loads. Whether the input is attacker-controlled requires separate verification.",
      "next_action": "Avoid pickle across trust boundaries; parse an appropriate data-only format.",
      "examples": [
        {
          "file": "app.py",
          "source": "pickle.loads(payload)\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.py",
          "source": "json.loads(payload)\n",
          "outcome": "not_applicable",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-HASH",
      "kind": "py-hash",
      "area": "cryptography",
      "severity": "medium",
      "title": "MD5 or SHA-1 with a named security purpose",
      "criteria": "Recognize hashlib.md5/sha1 on a line naming signature, token, password, credential, secret or HMAC. Other hash calls do not prove an adequate security mechanism.",
      "next_action": "Select a suitable established mechanism for the purpose; use a password KDF for passwords.",
      "examples": [
        {
          "file": "app.py",
          "source": "signature_digest = hashlib.md5(message)\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "app.py",
          "source": "cache_digest = hashlib.md5(content)\n",
          "outcome": "not_applicable",
          "expected_score": null,
          "expected_grade": null
        },
        {
          "file": "app.py",
          "source": "signature_digest = hashlib.sha256(message)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "PY-DEBUG",
      "kind": "py-debug",
      "area": "hardening",
      "severity": "medium",
      "title": "Flask-style debug flag enabled",
      "criteria": "Recognize app.run(debug=True/False); deployment exposure is not established.",
      "next_action": "Keep the debug server isolated from untrusted recipients and disable debug for deployed service operation.",
      "examples": [
        {
          "file": "app.py",
          "source": "app.run(debug=True)\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "app.py",
          "source": "app.run(debug=False)\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "app.py",
          "source": "app.run(debug=setting)\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "JS-EVAL",
      "kind": "js-eval",
      "area": "execution",
      "severity": "high",
      "title": "JavaScript code evaluation",
      "criteria": "Recognize eval/Function calls outside comments and string literals; JSON.parse is a data-only alternative.",
      "next_action": "Use fixed application operations and keep input as data.",
      "examples": [
        {
          "file": "app.js",
          "source": "eval(payload);\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.js",
          "source": "JSON.parse(payload);\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "JS-SHELL",
      "kind": "js-shell",
      "area": "execution",
      "severity": "high",
      "title": "JavaScript command execution through exec",
      "criteria": "Recognize direct exec/execSync and child_process.exec/execSync calls. Input origin and imported identity need verification.",
      "next_action": "Use an explicitly selected executable with an argument array and review shell options.",
      "examples": [
        {
          "file": "app.js",
          "source": "child_process.exec(command);\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.js",
          "source": "const message = 'exec(command)';\n",
          "outcome": "not_applicable",
          "expected_score": null,
          "expected_grade": null
        },
        {
          "file": "app.js",
          "source": "child_process.execFile(program, args);\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "JS-RANDOM",
      "kind": "js-random",
      "area": "cryptography",
      "severity": "high",
      "title": "Predictable random value for a named secret",
      "criteria": "Recognize Math.random on a line naming token, secret, otp, nonce, sessionId or resetToken; recognize crypto random APIs.",
      "next_action": "Generate security values with a cryptographic random API.",
      "examples": [
        {
          "file": "app.js",
          "source": "const token = Math.random();\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "app.js",
          "source": "const token = crypto.randomUUID();\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "JS-HTML",
      "kind": "js-html",
      "area": "output",
      "severity": "medium",
      "title": "Assignment to an HTML interpretation sink",
      "criteria": "Recognize innerHTML assignment; the narrow safe text alternative is textContent. Sanitizers and element context need separate verification.",
      "next_action": "Prefer textContent; if HTML is required, verify appropriate sanitization at the actual sink.",
      "examples": [
        {
          "file": "app.js",
          "source": "element.innerHTML = payload;\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "app.js",
          "source": "element.textContent = payload;\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "JS-TLS",
      "kind": "js-tls",
      "area": "transport",
      "severity": "high",
      "title": "Node certificate verification disabled",
