    {
      "id": "IAC-ACTION",
      "kind": "actions",
      "area": "supply-chain",
      "severity": "medium",
      "title": "Remote GitHub Action uses a mutable reference",
      "criteria": "Recognize remote uses declarations; a complete 40-hex commit or Docker digest satisfies the pinning check. A pin is not a vulnerability assessment.",
      "next_action": "Pin third-party actions to reviewed immutable commits or container digests.",
      "examples": [
        {
          "file": ".github/workflows/check.yml",
          "source": "steps:\n  - uses: example/action@main\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": ".github/workflows/check.yml",
          "source": "steps:\n  - uses: example/action@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "IAC-IMAGE",
      "kind": "image",
      "area": "supply-chain",
      "severity": "medium",
      "title": "Container base image has no immutable digest",
      "criteria": "Recognize FROM references; inspect all stages independently. Stage aliases and variables may need context.",
      "next_action": "Pin external base images to reviewed immutable digests.",
      "examples": [
        {
          "file": "Dockerfile",
          "source": "FROM node:latest\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "Dockerfile",
          "source": "FROM node@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "Dockerfile",
          "source": "FROM ${BASE_IMAGE}\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "IAC-USER",
      "kind": "user",
      "area": "hardening",
      "severity": "low",
      "title": "Container stage explicitly selects root",
      "criteria": "Recognize explicit USER root/0 and literal non-root identities. Builder stages may intentionally need root.",
      "next_action": "Use a non-root identity for the runtime stage and review the affected stage's purpose.",
      "examples": [
        {
          "file": "Dockerfile",
          "source": "USER root\n",
          "outcome": "violated",
          "expected_score": 89,
          "expected_grade": "B"
        },
        {
          "file": "Dockerfile",
          "source": "USER 1001\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "Dockerfile",
          "source": "USER ${APP_USER}\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "JS-SQL",
      "kind": "js-sql",
      "area": "injection",
      "severity": "high",
      "title": "Constructed SQL passed to a query call",
      "criteria": "Recognize query/execute calls starting with literal SQL. Interpolation and concatenation are violations; literal SQL satisfies only this construction check. Variable queries remain unclear.",
      "next_action": "Use a literal SQL statement and driver-bound parameters.",
      "examples": [
        {
          "file": "db.js",
          "source": "db.query(`SELECT * FROM items WHERE id=${id}`);\n",
          "outcome": "violated",
          "expected_score": 59,
          "expected_grade": "E"
        },
        {
          "file": "db.js",
          "source": "db.query('SELECT * FROM items WHERE id=$1', [id]);\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "db.js",
          "source": "db.query(query);\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "FRONTEND-BINDING",
      "kind": "frontend",
      "area": "output",
      "severity": "medium",
      "title": "Frontend bypasses protected output handling",
      "criteria": "Recognize React dangerouslySetInnerHTML and Angular bypassSecurityTrust APIs. Intrinsic JSX text children and Angular component interpolation are narrow positive signals, not framework-wide protection.",
      "next_action": "Prefer framework text binding; verify sanitization at any deliberate HTML or trust bypass.",
      "examples": [
        {
          "file": "View.jsx",
          "source": "return <div dangerouslySetInnerHTML={{__html: value}} />;\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "View.jsx",
          "source": "return <div>{value}</div>;\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "WEB-CSP",
      "kind": "csp",
      "area": "frontend-policy",
      "severity": "medium",
      "title": "CSP declares unsafe script execution",
      "criteria": "Recognize literal enforced CSP declarations. Wildcard, unsafe-inline, unsafe-eval and broad HTTP(S) script sources violate this check. Positive declarations restrict scripts and set object-src none, base-uri none and frame-ancestors. Delivery and nonce generation remain unverified.",
      "next_action": "Review the delivered policy and remove unsafe script execution allowances.",
      "examples": [
        {
          "file": "headers.py",
          "source": "response.headers['Content-Security-Policy'] = \"default-src 'self'; script-src 'unsafe-inline'\"\n",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "headers.py",
          "source": "response.headers['Content-Security-Policy'] = \"default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'\"\n",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "headers.py",
          "source": "response.headers['Content-Security-Policy'] = \"default-src 'self'\"\n",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
      "id": "NPM-SOURCES",
      "kind": "npm-sources",
      "area": "supply-chain",
      "severity": "medium",
      "title": "Dependency uses an insecure or mutable Git source",
      "criteria": "Inspect npm declarations. HTTP sources and Git dependencies without a full commit violate this check. Registry resolution requires lock evidence; local/workspace sources remain unclear.",
      "next_action": "Use TLS and reviewed immutable commits for Git dependencies; maintain a consistent lockfile.",
      "examples": [
        {
          "file": "package.json",
          "source": "{\"dependencies\":{\"example\":\"git+https://github.com/example/library.git#main\"}}",
          "outcome": "violated",
          "expected_score": 79,
          "expected_grade": "C"
        },
        {
          "file": "package.json",
          "source": "{\"dependencies\":{\"example\":\"git+https://github.com/example/library.git#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}",
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        },
        {
          "file": "package.json",
          "source": "{\"dependencies\":{\"example\":\"^1.0.0\"}}",
          "outcome": "unclear",
          "expected_score": null,
          "expected_grade": null
        }
      ]
    },
    {
