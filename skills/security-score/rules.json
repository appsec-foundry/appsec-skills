          "expected_grade": null
        },
        {
          "file": "package.json",
          "source": "{\"dependencies\":{\"example\":\"1.0.0\"}}",
          "files": {
            "package-lock.json": "{\"lockfileVersion\":3,\"packages\":{\"\":{\"dependencies\":{\"example\":\"1.0.0\"}}}}"
          },
          "outcome": "satisfied",
          "expected_score": 100,
          "expected_grade": "A"
        }
      ]
    },
    {
      "id": "PY-DEPENDENCIES",
      "kind": "requirements",
      "area": "supply-chain",
      "severity": "medium",
      "title": "Python install requirements are not exactly pinned",
      "criteria": "Inspect active requirement lines. Floating or HTTP requirements violate this check. An exact version with a SHA-256 hash is a positive declaration. Includes, options and unhashed pins remain unclear.",
      "next_action": "Use reviewed exact versions and hashes for reproducible application installation; inspect included constraints.",
