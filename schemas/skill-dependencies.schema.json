{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable skill engine requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine", "interface_versions", "required_commands", "required_capabilities", "model_prerequisites", "optional_tools", "qualification"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"const": "appsec-analyzer"},
    "interface_versions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "required_commands": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
    "required_capabilities": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["available", "model_calls"],
        "properties": {
          "available": {"const": true},
          "model_calls": {"type": "boolean"},
          "scoring_version": {"type": "integer", "minimum": 1},
          "preview_model_calls": {"const": false},
          "hosts": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
        }
      }
    },
    "model_prerequisites": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "optional_tools": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "qualification": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
